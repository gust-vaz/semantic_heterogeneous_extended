# Cloud campaign configuration. The single place to edit.
GCP_REGION="${GCP_REGION:-us-central1}"
GCP_ZONE="${GCP_ZONE:-us-central1-a}"
GCP_SUBNET_CIDR="${GCP_SUBNET_CIDR:-10.10.0.0/24}"
NAME_PREFIX="${NAME_PREFIX:-mellow}"
CONTROL_MACHINE="${CONTROL_MACHINE:-n2-standard-4}"
SHARD_MACHINE="${SHARD_MACHINE:-e2-small}"
MONGO_IMAGE="${MONGO_IMAGE:-mongo:8.0.12}"
REPO_URL="${REPO_URL:-}"        # clone URL for the control VM; set before provisioning
AUTHOR_IP="${AUTHOR_IP:-}"      # your public IP; if empty, provision.sh looks it up

shard_count_for() {
  case "$1" in
    sh1) echo 1 ;;
    sh4) echo 4 ;;
    sh8) echo 8 ;;
    *) echo "Unknown deployment '$1'" >&2; return 1 ;;
  esac
}
